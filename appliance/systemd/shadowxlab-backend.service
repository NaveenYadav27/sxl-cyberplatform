[Unit]
Description=ShadowXLab Cyber-Range Appliance Core Service
After=network.target network-online.target systemd-timesyncd.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/shadowxlab/backend
Environment=SHADOWXLAB_DATA_DIR=/var/lib/shadowxlab
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/local/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
