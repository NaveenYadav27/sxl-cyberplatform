# ShadowXLab Backend API Keys
# Add your real API keys here and restart the backend server

# VirusTotal API Key - Free tier: 500 lookups/day
# Get key: https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=

# AbuseIPDB API Key - Free tier: 1000 checks/day
# Get key: https://www.abuseipdb.com/register
ABUSEIPDB_API_KEY=

# Hunter.io API Key - Free tier: 25 searches/month
# Get key: https://hunter.io/users/sign_up
HUNTER_API_KEY=

# -- The following tools require NO API keys --
# Shodan InternetDB (public, free)
# HIBP Password Range (public, free)
# Real TCP Port Scanner (built-in)
# DNS Resolver (built-in)
# CyberChef (embedded GCHQ app)
